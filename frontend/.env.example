# Frontend - Variables de entorno para Vite
# Copiar a .env.development.local

# URL del backend. En Docker compose se inyecta en runtime vía /config.js.
VITE_API_BASE_URL=http://localhost:8000

# URL del proveedor OIDC (Keycloak en dev).
VITE_AUTH_URL=http://localhost:8081/realms/plagas

# Ambiente (afecta el logger y el Sentry DSN).
VITE_APP_ENV=dev

# OIDC client (debe coincidir con el cliente configurado en Keycloak).
VITE_OIDC_CLIENT_ID=app-plagas-frontend
VITE_OIDC_REDIRECT_URI=http://localhost:5173/login/callback
VITE_OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:5173/
